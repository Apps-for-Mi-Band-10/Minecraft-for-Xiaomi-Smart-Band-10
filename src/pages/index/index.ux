    normalMinedTotal:0, netherMinedTotal:0, endMinedTotal:0, endWinTarget:150, endWinLabel:"END WIN BLOCKS: 150", netherUnlockTarget:50, netherUnlockLabel:"NETHER UNLOCK: 50", netherProgressLabel:"MINE 50 BLOCKS TO UNLOCK", worldsNetherLabel:"NETHER: LOCKED", worldsNetherStyle:"background-color:#333b42;color:#777f86;", endUnlockTarget:100, endUnlockLabel:"END UNLOCK: 100", endProgressLabel:"MINE 100 NETHER BLOCKS TO UNLOCK", worldsEndLabel:"THE END: LOCKED", worldsEndStyle:"background-color:#333b42;color:#777f86;", netherInventoryDisplay:"none", netherInventoryLabel:"▼ NETHER BLOCKS", endInventoryDisplay:"none", endInventoryLabel:"▼ END BLOCKS",
    chestStorage:{}, currentChestKey:"",
    settingsSection:"MAIN", settingsSectionTitle:"GAME SETTINGS",
    settingsMainDisplay:"flex", settingsDisplaySectionDisplay:"none", settingsControlsSectionDisplay:"none", settingsGameSectionDisplay:"none", settingsGraphicsSectionDisplay:"none", settingsAccessibilitySectionDisplay:"none",
    showGrid:false, blockOutline:true, zoomDefaultIndex:1,
    autoJump:true, confirmReset:true, resetArmed:false, pauseMenus:true, craftingTableButtonDisplay:"none", workbenchStatus:"Crafting table ready",
    worldAnimation:false, waterAnimation:false, leafAnimation:false, nightDarkness:1, animationFrame:0, weatherEnabled:false, weatherStage:"CLEAR", weatherTick:0, skyText:"SUN", weatherLabel:"WEATHER: OFF", weatherCycle:0, cloudText:"",
    showGridLabel:"SHOW GRID: OFF", blockOutlineLabel:"BLOCK OUTLINE: ON", zoomDefaultLabel:"DEFAULT ZOOM: 100%",
    autoJumpLabel:"AUTO JUMP: ON",
    confirmResetLabel:"CONFIRM RESET: ON", pauseMenusLabel:"PAUSE IN MENUS: ON",
    worldAnimationLabel:"WORLD ANIMATION: OFF", waterAnimationLabel:"WATER ANIMATION: OFF", leafAnimationLabel:"LEAF ANIMATION: OFF", nightDarknessLabel:"NIGHT DARKNESS: NORMAL", weatherLabel:"WEATHER: OFF",
    controlStyle:"width:33px;height:17px;font-size:5px;", controlsRowStyle:"width:104px;height:19px;flex-direction:row;justify-content:center;align-items:center;",
    inventory:{dirt:0,stone:0,wood:0,leaf:0,sand:0,glass:0,brick:0,torch:0,water:0,chest:0,craftingTable:0,coal:0,iron:0,gold:0,diamond:0,netherrack:0,soulSand:0,glowstone:0,netherBrick:0,quartzOre:0,blackstone:0,endStone:0,obsidian:0,purpur:0,chorusPlant:0,endBrick:0,endOre:0},
    toolType:"hand", toolLabel:"HAND", pickaxeDurability:100, axeDurability:100,
