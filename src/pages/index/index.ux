<template>
  <div class="page">
    <div class="loading" style="display: {{ loadingDisplay }}">
      <text class="loading-title">Minecraft 2D</text>
      <text class="loading-label">{{ loadingLabel }}</text>
      <div class="loading-bar"><div class="loading-fill" style="width: {{ loadingProgress }}px"></div></div>
      <text class="loading-percent">{{ loadingProgress }}%</text>
    </div>

    <div class="menu" style="display: {{ menuDisplay }}">
      <text class="menu-title">Minecraft 2D</text>
      <text class="menu-subtitle">2D BLOCK ADVENTURE</text>
      <input class="play-button" type="button" value="PLAY" onclick="startGame" />
      <input class="settings-button" type="button" value="SETTINGS" onclick="openSettings" />
    </div>

    <div class="settings" style="display: {{ settingsDisplay }}">
      <text class="menu-title">SETTINGS</text>
      <text class="menu-subtitle">{{ settingsSectionTitle }}</text>

      <div class="settings-panel" style="display: {{ settingsMainDisplay }}">
        <text class="section-label">SECTIONS</text>
        <input class="section-btn" type="button" value="DISPLAY" onclick="openSettingsDisplay" />
        <input class="section-btn" type="button" value="CONTROLS" onclick="openSettingsControls" />
        <input class="section-btn" type="button" value="GAME" onclick="openSettingsGame" />
        <input class="section-btn" type="button" value="GRAPHICS" onclick="openSettingsGraphics" />
        <input class="section-btn" type="button" value="ACCESSIBILITY" onclick="openSettingsAccessibility" />
        <input class="close-inv" type="button" value="BACK" onclick="closeSettings" />
      </div>

      <div class="settings-panel" style="display: {{ settingsDisplaySectionDisplay }}">
        <input class="setting-btn" type="button" value="{{ dayNightLabel }}" onclick="toggleDayNight" />
        <input class="setting-btn" type="button" value="{{ showGridLabel }}" onclick="toggleGrid" />
        <input class="setting-btn" type="button" value="{{ blockOutlineLabel }}" onclick="toggleBlockOutline" />
        <input class="setting-btn" type="button" value="{{ zoomDefaultLabel }}" onclick="cycleDefaultZoom" />
        <input class="close-inv" type="button" value="BACK" onclick="backSettingsMain" />
      </div>

      <div class="settings-panel" style="display: {{ settingsControlsSectionDisplay }}">
        <input class="setting-btn" type="button" value="{{ autoJumpLabel }}" onclick="toggleAutoJump" />
        <input class="close-inv" type="button" value="BACK" onclick="backSettingsMain" />
      </div>

      <div class="settings-panel" style="display: {{ settingsGameSectionDisplay }}">
        <input class="setting-btn" type="button" value="{{ confirmResetLabel }}" onclick="toggleConfirmReset" />
        <input class="setting-btn" type="button" value="{{ pauseMenusLabel }}" onclick="togglePauseMenus" />
        <input class="setting-btn" type="button" value="{{ netherUnlockLabel }}" onclick="cycleNetherUnlock" />
        <input class="setting-btn" type="button" value="{{ endUnlockLabel }}" onclick="cycleEndUnlock" />
        <input class="setting-btn" type="button" value="{{ endWinLabel }}" onclick="cycleEndWinTarget" />
        <input class="close-inv" type="button" value="BACK" onclick="backSettingsMain" />
      </div>

      <div class="settings-panel" style="display: {{ settingsGraphicsSectionDisplay }}">
        <input class="setting-btn" type="button" value="{{ worldAnimationLabel }}" onclick="toggleWorldAnimation" />
        <input class="setting-btn" type="button" value="{{ waterAnimationLabel }}" onclick="toggleWaterAnimation" />
        <input class="setting-btn" type="button" value="{{ leafAnimationLabel }}" onclick="toggleLeafAnimation" />
        <input class="setting-btn" type="button" value="{{ nightDarknessLabel }}" onclick="cycleNightDarkness" />
        <input class="setting-btn" type="button" value="{{ weatherLabel }}" onclick="toggleWeather" />
        <input class="close-inv" type="button" value="BACK" onclick="backSettingsMain" />
      </div>

      <div class="settings-panel" style="display: {{ settingsAccessibilitySectionDisplay }}">
        <input class="setting-btn" type="button" value="{{ highContrastLabel }}" onclick="toggleHighContrast" />
        <input class="setting-btn" type="button" value="{{ largeOutlineLabel }}" onclick="toggleLargeOutline" />
        <input class="setting-btn" type="button" value="{{ largeTextLabel }}" onclick="toggleLargeText" />
        <input class="close-inv" type="button" value="BACK" onclick="backSettingsMain" />
      </div>
    </div>

    <div class="slots" style="display: {{ slotMenuDisplay }}">
      <text class="menu-title">SELECT WORLD</text>
      <text class="menu-subtitle">5 WORLDS</text>
      <input class="slot-button" type="button" value="WORLD 1" onclick="selectSlot1" /><text class="slot-info">NORMAL WORLD</text>
      <input class="slot-button" type="button" value="WORLD 2" onclick="selectSlot2" /><text class="slot-info">HOUSE WORLD</text>
      <input class="slot-button" type="button" value="WORLD 3" onclick="selectSlot3" /><text class="slot-info">VILLAGE WORLD</text>
      <input class="slot-button" type="button" value="WORLD 4" onclick="selectSlot4" /><text class="slot-info">DEEP MINE</text>
      <input class="slot-button" type="button" value="WORLD 5" onclick="selectSlot5" /><text class="slot-info">ISLAND WORLD</text>
    </div>

    <div class="game" style="display: {{ gameDisplay }}">
      <div class="hud"><text class="title">Minecraft 2D</text><text class="hud-line">{{ hudLine }}</text></div>
      <div class="world"><text class="cell" for="{{ visibleWorld }}" onclick="tapCell($item.x, $item.y)" style="{{ $item.style }}">{{ $item.char }}</text></div>
      <text class="status">{{ status }}</text>
      <div class="controls-row" style="{{ controlsRowStyle }}">
        <input class="control" style="{{ controlStyle }}" type="button" value="LEFT" onclick="moveLeft" />
        <input class="control" style="{{ controlStyle }}" type="button" value="JUMP" onclick="jump" />
        <input class="control" style="{{ controlStyle }}" type="button" value="RIGHT" onclick="moveRight" />
      </div>
      <div class="controls-row" style="{{ controlsRowStyle }}">
        <input class="control" style="{{ controlStyle }}" type="button" value="MINE" onclick="setMineMode" />
        <input class="control" style="{{ controlStyle }}" type="button" value="PLACE" onclick="setPlaceMode" />
        <input class="control" style="{{ controlStyle }}" type="button" value="INVENTORY" onclick="openInventory" />
      </div>
      <div class="controls-row" style="{{ controlsRowStyle }}">
        <input class="control" style="{{ controlStyle }}" type="button" value="ZOOM-" onclick="zoomOut" />
        <input class="control" style="{{ controlStyle }}" type="button" value="ZOOM+" onclick="zoomIn" />
        <input class="control" style="{{ controlStyle }}" type="button" value="SLOTS" onclick="backToSlots" />
      </div>
      <div class="controls-row" style="{{ controlsRowStyle }}">
        <input class="control" style="{{ controlStyle }}" type="button" value="RESET" onclick="resetGame" />
        <input class="control" style="{{ controlStyle }}" type="button" value="MORE" onclick="openExtra" />
      </div>
    </div>

    <div class="extra" style="display: {{ extraDisplay }}">
      <text class="menu-title">MORE</text>
      <text class="menu-subtitle">TOOLS / MAP / GOALS</text>
      <input class="section-btn" type="button" value="MAP" onclick="openMap" />
      <input class="section-btn" type="button" value="TOOLS" onclick="openTools" />
      <input class="section-btn" type="button" value="QUESTS" onclick="openQuests" />
      <input class="section-btn" type="button" value="ACHIEVEMENTS" onclick="openAchievements" />
      <input class="section-btn" type="button" value="CRAFT" onclick="openCraft" />
      <input class="section-btn" type="button" value="WORLDS" onclick="openWorlds" />
      <input class="close-inv" type="button" value="CLOSE" onclick="closeExtra" />
    </div>

    <div class="worlds-screen" style="display: {{ worldsDisplay }}">
      <text class="menu-title">WORLDS</text>
      <text class="menu-subtitle">DIMENSIONS</text>
      <input class="section-btn" type="button" value="NORMAL WORLD" onclick="switchToNormalWorld" />
      <text class="worlds-info">SAVED NORMAL WORLD</text>
      <input class="section-btn" style="{{ worldsNetherStyle }}" type="button" value="{{ worldsNetherLabel }}" onclick="switchToNetherWorld" />
      <text class="worlds-info">{{ netherProgressLabel }}</text>
      <input class="section-btn" style="{{ worldsEndStyle }}" type="button" value="{{ worldsEndLabel }}" onclick="switchToEndWorld" />
      <text class="worlds-info">{{ endProgressLabel }}</text>
      <input class="close-inv" type="button" value="BACK" onclick="closeWorlds" />
    </div>

    <div class="slots-confirm-screen" style="display: {{ slotsConfirmDisplay }}">
      <text class="confirm-title">RETURN TO SLOTS?</text>
      <text class="menu-subtitle">SELECTING A SLOT RESETS WORLD</text>
      <input class="section-btn" type="button" value="YES, OPEN SLOTS" onclick="confirmBackToSlots" />
      <input class="close-inv" type="button" value="CANCEL" onclick="cancelBackToSlots" />
    </div>

    <div class="victory-screen" style="display: {{ victoryDisplay }}">
      <text class="victory-stars">* * * * *</text>
      <text class="victory-title">VICTORY!</text>
      <text class="victory-subtitle">YOU CONQUERED THE END</text>
      <text class="victory-progress">{{ endMinedTotal }} / {{ endWinTarget }} END BLOCKS</text>
      <input class="victory-menu" type="button" value="MENU" onclick="returnToMainMenu" />
    </div>


    <div class="craft-screen" style="display: {{ craftDisplay }}">
      <text class="menu-title">CRAFT</text>
      <text class="menu-subtitle">USE MATERIALS TO CRAFT BLOCKS</text>
      <text class="craft-info">WOOD {{ inventory.wood }} | SAND {{ inventory.sand }} | COAL {{ inventory.coal }}</text>
      <input class="craft-btn" type="button" value="GLASS  1 SAND -> 1" onclick="craftGlass" />
      <input class="craft-btn" type="button" value="BRICK  2 STONE -> 1" onclick="craftBrick" />
      <input class="craft-btn" type="button" value="TORCH  1 COAL + 1 WOOD -> 2" onclick="craftTorch" />
      <input class="craft-btn" type="button" value="CHEST  4 WOOD -> 1" onclick="craftChest" />
      <input class="craft-btn" type="button" value="CRAFTING TABLE  4 WOOD -> 1" onclick="craftCraftingTable" />
      <text class="craft-status">{{ craftStatus }}</text>
      <input class="close-inv" type="button" value="BACK" onclick="closeCraft" />
    </div>

    <div class="workbench-screen" style="display: {{ workbenchDisplay }}">
      <text class="menu-title">CRAFTING TABLE</text>
      <text class="menu-subtitle">CRAFT / REPAIR</text>
      <text class="craft-info">PICKAXE {{ pickaxeDurability }}% | AXE {{ axeDurability }}%</text>
      <text class="craft-info">WOOD {{ inventory.wood }} | STONE {{ inventory.stone }} | IRON {{ inventory.iron }}</text>
      <input class="craft-btn" type="button" value="PICKAXE: WOOD +10" onclick="repairPickaxeWood" />
      <input class="craft-btn" type="button" value="PICKAXE: STONE +50" onclick="repairPickaxeStone" />
      <input class="craft-btn" type="button" value="PICKAXE: IRON +100" onclick="repairPickaxeIron" />
      <input class="craft-btn" type="button" value="AXE: WOOD +10" onclick="repairAxeWood" />
      <input class="craft-btn" type="button" value="AXE: STONE +50" onclick="repairAxeStone" />
      <input class="craft-btn" type="button" value="AXE: IRON +100" onclick="repairAxeIron" />
      <text class="craft-status">{{ workbenchStatus }}</text>
      <input class="close-inv" type="button" value="CLOSE" onclick="closeWorkbench" />
    </div>

    <div class="map-screen" style="display: {{ mapDisplay }}">
      <text class="menu-title">MAP</text>
      <text class="map-text">{{ mapText }}</text>
      <text class="map-hint">@ PLAYER  # LAND  ~ WATER</text>
      <input class="close-inv" type="button" value="CLOSE" onclick="closeMap" />
    </div>

    <div class="tools-screen" style="display: {{ toolsDisplay }}">
      <text class="menu-title">TOOLS</text>
      <text class="menu-subtitle">{{ toolLabel }}</text>
      <input class="setting-btn" type="button" value="PICKAXE {{ pickaxeDurability }}%" onclick="selectPickaxe" />
      <input class="setting-btn" type="button" value="AXE {{ axeDurability }}%" onclick="selectAxe" />
      <input class="setting-btn" type="button" value="HAND" onclick="selectHand" />
      <input class="close-inv" type="button" value="CLOSE" onclick="closeTools" />
    </div>

    <div class="quests-screen" style="display: {{ questsDisplay }}">
      <text class="menu-title">QUESTS</text>
      <text class="quest-text">{{ questText }}</text>
      <input class="close-inv" type="button" value="CLOSE" onclick="closeQuests" />
    </div>

    <div class="ach-screen" style="display: {{ achievementsDisplay }}">
      <text class="menu-title">ACHIEVEMENTS</text>
      <text class="quest-text">{{ achievementText }}</text>
      <input class="close-inv" type="button" value="CLOSE" onclick="closeAchievements" />
    </div>

    <div class="inventory" style="display: {{ inventoryDisplay }}">
      <text class="menu-title">INVENTORY</text>
      <text class="menu-subtitle">SELECT BLOCK</text>
      <div class="inv-row">
        <div class="inv-btn" onclick="selectDirtFromInventory"><text class="inv-name">DIRT</text><text class="inv-count">{{ inventory.dirt }}</text></div>
        <div class="inv-btn" onclick="selectStoneFromInventory"><text class="inv-name">STONE</text><text class="inv-count">{{ inventory.stone }}</text></div>
        <div class="inv-btn" onclick="selectWoodFromInventory"><text class="inv-name">WOOD</text><text class="inv-count">{{ inventory.wood }}</text></div>
        <div class="inv-btn" onclick="selectLeafFromInventory"><text class="inv-name">LEAF</text><text class="inv-count">{{ inventory.leaf }}</text></div>
      </div>
      <div class="inv-row">
        <div class="inv-btn" onclick="selectSandFromInventory"><text class="inv-name">SAND</text><text class="inv-count">{{ inventory.sand }}</text></div>
        <div class="inv-btn" onclick="selectGlassFromInventory"><text class="inv-name">GLASS</text><text class="inv-count">{{ inventory.glass }}</text></div>
        <div class="inv-btn" onclick="selectBrickFromInventory"><text class="inv-name">BRICK</text><text class="inv-count">{{ inventory.brick }}</text></div>
        <div class="inv-btn" onclick="selectTorchFromInventory"><text class="inv-name">TORCH</text><text class="inv-count">{{ inventory.torch }}</text></div>
      </div>
      <div class="inv-row">
        <div class="inv-btn" onclick="selectWaterFromInventory"><text class="inv-name">WATER</text><text class="inv-count">{{ inventory.water }}</text></div>
        <div class="inv-btn" onclick="selectChestFromInventory"><text class="inv-name">CHEST</text><text class="inv-count">{{ inventory.chest }}</text></div>
        <div class="inv-btn" onclick="selectCoalFromInventory"><text class="inv-name">COAL</text><text class="inv-count">{{ inventory.coal }}</text></div>
        <div class="inv-btn" onclick="selectIronFromInventory"><text class="inv-name">IRON</text><text class="inv-count">{{ inventory.iron }}</text></div>
      </div>
      <div class="inv-row">
        <div class="inv-btn" style="display: {{ craftingTableButtonDisplay }}" onclick="selectCraftingTableFromInventory"><text class="inv-name">TABLE</text><text class="inv-count">{{ inventory.craftingTable }}</text></div>
        <div class="inv-btn" onclick="selectGoldFromInventory"><text class="inv-name">GOLD</text><text class="inv-count">{{ inventory.gold }}</text></div>
        <div class="inv-btn" onclick="selectDiamondFromInventory"><text class="inv-name">DIAMOND</text><text class="inv-count">{{ inventory.diamond }}</text></div>
      </div>
      <input class="nether-arrow" type="button" value="{{ netherInventoryLabel }}" onclick="toggleNetherInventory" />
      <div class="nether-blocks" style="display: {{ netherInventoryDisplay }}">
        <div class="inv-row">
          <div class="inv-btn" onclick="selectNetherrackFromInventory"><text class="inv-name">NETHERRACK</text><text class="inv-count">{{ inventory.netherrack }}</text></div>
          <div class="inv-btn" onclick="selectSoulSandFromInventory"><text class="inv-name">SOUL SAND</text><text class="inv-count">{{ inventory.soulSand }}</text></div>
          <div class="inv-btn" onclick="selectGlowstoneFromInventory"><text class="inv-name">GLOWSTONE</text><text class="inv-count">{{ inventory.glowstone }}</text></div>
          <div class="inv-btn" onclick="selectNetherBrickFromInventory"><text class="inv-name">NETHER BRICK</text><text class="inv-count">{{ inventory.netherBrick }}</text></div>
        </div>
        <div class="inv-row">
          <div class="inv-btn" onclick="selectQuartzOreFromInventory"><text class="inv-name">QUARTZ</text><text class="inv-count">{{ inventory.quartzOre }}</text></div>
          <div class="inv-btn" onclick="selectBlackstoneFromInventory"><text class="inv-name">BLACKSTONE</text><text class="inv-count">{{ inventory.blackstone }}</text></div>
        </div>
      </div>
      <input class="end-arrow" type="button" value="{{ endInventoryLabel }}" onclick="toggleEndInventory" />
      <div class="end-blocks" style="display: {{ endInventoryDisplay }}">
        <div class="inv-row">
          <div class="inv-btn" onclick="selectEndStoneFromInventory"><text class="inv-name">END STONE</text><text class="inv-count">{{ inventory.endStone }}</text></div>
          <div class="inv-btn" onclick="selectObsidianFromInventory"><text class="inv-name">OBSIDIAN</text><text class="inv-count">{{ inventory.obsidian }}</text></div>
          <div class="inv-btn" onclick="selectPurpurFromInventory"><text class="inv-name">PURPUR</text><text class="inv-count">{{ inventory.purpur }}</text></div>
        </div>
        <div class="inv-row">
          <div class="inv-btn" onclick="selectChorusPlantFromInventory"><text class="inv-name">CHORUS</text><text class="inv-count">{{ inventory.chorusPlant }}</text></div>
          <div class="inv-btn" onclick="selectEndBrickFromInventory"><text class="inv-name">END BRICK</text><text class="inv-count">{{ inventory.endBrick }}</text></div>
          <div class="inv-btn" onclick="selectEndOreFromInventory"><text class="inv-name">END ORE</text><text class="inv-count">{{ inventory.endOre }}</text></div>
        </div>
      </div>
      <input class="close-inv" type="button" value="CLOSE" onclick="closeInventory" />
    </div>

    <div class="chest" style="display: {{ chestDisplay }}">
      <text class="menu-title">CHEST</text>
      <text class="menu-subtitle">{{ selectedBlock }} | PLAYER {{ selectedCountText() }} | CHEST {{ chestCount() }}</text>
      <div class="chest-slot"><text class="chest-block">{{ selectedBlock }}</text><text class="chest-count">{{ chestCount() }}</text></div>
      <div class="chest-row">
        <input class="chest-btn" type="button" value="STORE" onclick="storeInChest" />
        <input class="chest-btn" type="button" value="TAKE" onclick="takeFromChest" />
      </div>
      <text class="chest-hint">Choose a block in INVENTORY first</text>
      <input class="close-inv" type="button" value="CLOSE" onclick="closeChest" />
    </div>
  </div>
</template>

<script>
var COLS = 20
var ROWS = 30
var WORLD_W = 96
var WORLD_H = 129
var ZOOM_LEVELS = [15, 18, 21]
var SKY = "#78b6e8"
var HIGH_CONTRAST_COLORS = {
  grass:"#00ff00",dirt:"#b86500",stone:"#d0d0d0",bedrock:"#111111",wood:"#ffb000",leaf:"#00ff55",
  coal:"#ffffff",iron:"#c8c8ff",gold:"#ffff00",diamond:"#00ffff",sand:"#ffff66",glass:"#baf5ff",brick:"#ff5a45",
  netherrack:"#ff4b3e",soulSand:"#9a7860",glowstone:"#ffff66",netherBrick:"#ff5068",quartzOre:"#ffffff",blackstone:"#606070",
  endStone:"#fff6bd",obsidian:"#4b3d68",purpur:"#ff5dff",chorusPlant:"#dfaaff",endBrick:"#bca0dd",endOre:"#ffffff",
  water:"#0088ff",torch:"#ffff00",chest:"#ff9d00",craftingTable:"#d88a3b"
}

function makeTile(x, y, type) { return { x:x, y:y, type:type } }

function flatTerrainWorld(seed) {
  var world=[]
  var heights=[]
  var x,y
  var profile=[13,13,12,12,13,13,14,13,12,12,13,14,13,12,12,13,13,14,13,13]
  for(x=0;x<COLS;x++) heights[x]=profile[(x+seed)%profile.length]
  for(y=0;y<ROWS;y++) for(x=0;x<COLS;x++){
    var surface=heights[x], type="air"
    if(y===surface) type="grass"
    else if(y>surface && y<=surface+2) type="dirt"
    else if(y>surface+2){
      type=y===ROWS-1?"bedrock":"stone"
      if(y<surface+7 && ((x*11+y*7+seed)%17===0)) type="coal"
      if(y<surface+10 && ((x*5+y*13+seed)%29===0)) type="iron"
      if(y<surface+13 && ((x*17+y*3+seed)%43===0)) type="gold"
      if(y<surface+16 && ((x*19+y*5+seed)%61===0)) type="diamond"
    }
    world.push(makeTile(x,y,type))
  }
  function put(px,py,t){if(px<0||px>=COLS||py<0||py>=ROWS)return;world[py*COLS+px]=makeTile(px,py,t)}
  // Natural cave pockets only below the surface.
  for(var cx=2;cx<COLS-2;cx++){
    var s=heights[cx]
    if(((cx*7+seed)%5)===0){ put(cx,s+5,"air"); put(cx+1,s+5,"air"); put(cx,s+6,"air") }
  }
  // Two clear lakes at ground level.
  if(seed!==7){
    var lakeX=9+((seed*2)%3)
    var lakeY=heights[Math.min(COLS-1,lakeX)]
    put(lakeX,lakeY,"water"); put(lakeX+1,lakeY,"water"); put(lakeX+2,lakeY,"water")
    put(lakeX+1,lakeY-1,"sand")
  }
  // Trees planted on their actual ground height.
  var treeXs=[2,6,14,17]
  for(var i=0;i<treeXs.length;i++){
    var tx=treeXs[i], sy=heights[tx]-1
    put(tx,sy,"wood"); put(tx,sy-1,"wood"); put(tx,sy-2,"wood")
    put(tx-1,sy-2,"leaf"); put(tx+1,sy-2,"leaf"); put(tx,sy-3,"leaf")
    put(tx-1,sy-3,"leaf"); put(tx+1,sy-3,"leaf")
  }
  return world
}

function createWorld(){return flatTerrainWorld(1)}

function createHouseWorld(){
  var world=flatTerrainWorld(2),put=function(x,y,t){if(x<0||x>=COLS||y<0||y>=ROWS)return;world[y*COLS+x]=makeTile(x,y,t)}
  // Flatten house footprint.
  for(var x=4;x<=14;x++){put(x,13,"grass");put(x,14,"dirt");put(x,15,"dirt")}
  for(x=5;x<=13;x++){put(x,12,"wood");put(x,8,"brick")}
  for(var y=8;y<=12;y++){put(5,y,"wood");put(13,y,"wood")}
  put(7,10,"glass"); put(11,10,"glass"); put(9,11,"air"); put(9,12,"air")
  put(9,12,"chest"); put(6,9,"torch"); put(12,9,"torch")
  // Simple roof slope.
  put(6,7,"brick"); put(7,7,"brick"); put(8,7,"brick"); put(9,7,"brick"); put(10,7,"brick"); put(11,7,"brick"); put(12,7,"brick")
  return world
}

function createVillageWorld(){
  var world=flatTerrainWorld(4),put=function(x,y,t){if(x<0||x>=COLS||y<0||y>=ROWS)return;world[y*COLS+x]=makeTile(x,y,t)}
  for(var x=2;x<=17;x++){put(x,13,"grass");put(x,14,"dirt");put(x,15,"dirt")}
  function house(cx){
    for(var hx=cx-2;hx<=cx+2;hx++){put(hx,12,"brick");put(hx,8,"brick")}
    for(var hy=8;hy<=12;hy++){put(cx-2,hy,"brick");put(cx+2,hy,"brick")}
    put(cx,10,"glass");put(cx,11,"air");put(cx,11,"chest");put(cx-1,9,"torch");put(cx+1,9,"torch")
  }
  house(6);house(14)
  for(x=9;x<=11;x++)put(x,13,"sand")
  put(10,12,"water");put(10,13,"water")
  return world
}

function createMineWorld(){
  var world=flatTerrainWorld(7),put=function(x,y,t){if(x<0||x>=COLS||y<0||y>=ROWS)return;world[y*COLS+x]=makeTile(x,y,t)}
  // Safe entrance and a clean underground corridor.
  for(var y=9;y<=20;y++){put(9,y,"air");put(10,y,"air")}
  for(var x=7;x<=12;x++)put(x,20,"stone")
  put(9,9,"torch");put(10,13,"torch");put(8,16,"coal");put(11,17,"iron");put(8,18,"gold");put(11,19,"diamond");put(7,19,"chest")
  return world
}

function createIslandWorld(){
  var world=[],x,y
  for(y=0;y<ROWS;y++)for(x=0;x<COLS;x++)world.push(makeTile(x,y,"water"))
  function put(px,py,t){if(px<0||px>=COLS||py<0||py>=ROWS)return;world[py*COLS+px]=makeTile(px,py,t)}
  for(x=2;x<=17;x++)for(y=12;y<=16;y++)put(x,y,(y===12)?"grass":(y>=15?"stone":"dirt"))
  for(x=3;x<=16;x++)put(x,12,"grass")
  put(6,11,"wood");put(6,10,"wood");put(5,10,"leaf");put(7,10,"leaf");put(6,9,"leaf")
  put(11,12,"chest");put(12,12,"sand");put(13,12,"sand");put(14,12,"sand")
  return world
}

function createNetherWorld(){
  var world=[],x,y
  function put(px,py,t){if(px<0||px>=COLS||py<0||py>=ROWS)return;world[py*COLS+px]=makeTile(px,py,t)}
  for(y=0;y<ROWS;y++)for(x=0;x<COLS;x++){
    var type="air"
    if(y<=3||y>=15||x===0||x===COLS-1)type="netherrack"
    world.push(makeTile(x,y,type))
  }
  for(x=2;x<=17;x++){put(x,13,"netherrack");put(x,14,"netherrack");put(x,15,"netherrack")}
  for(x=4;x<=6;x++)put(x,12,"soulSand")
  for(x=14;x<=16;x++)put(x,12,"soulSand")
  for(y=7;y<=12;y++){put(3,y,"blackstone");put(16,y,"blackstone")}
  put(4,9,"blackstone");put(15,8,"blackstone")
  put(6,4,"glowstone");put(7,4,"glowstone");put(8,4,"glowstone");put(7,5,"glowstone")
  put(13,4,"glowstone");put(14,4,"glowstone");put(13,5,"glowstone")
  put(5,10,"quartzOre");put(6,10,"quartzOre");put(12,11,"quartzOre");put(13,10,"quartzOre")
  for(x=9;x<=12;x++){put(x,9,"netherBrick");put(x,10,"netherBrick")}
  put(9,8,"netherBrick");put(12,8,"netherBrick")
  put(5,11,"air");put(5,10,"air");put(6,11,"air");put(6,10,"air")
  return world
}

function createEndWorld(){
  var world=[],x,y
  function put(px,py,t){if(px<0||px>=COLS||py<0||py>=ROWS)return;world[py*COLS+px]=makeTile(px,py,t)}
  for(y=0;y<ROWS;y++)for(x=0;x<COLS;x++){var type=(y>=15)?"endStone":"air";if((x===0||x===COLS-1)&&y>=13)type="obsidian";world.push(makeTile(x,y,type))}
  for(x=2;x<=6;x++){put(x,10,"endStone");put(x,11,"endStone")}
  for(x=13;x<=17;x++){put(x,9,"endStone");put(x,10,"endStone")}
  for(y=7;y<=14;y++){put(7,y,"obsidian");put(12,y,"obsidian")}
  for(x=8;x<=11;x++){put(x,13,"purpur");put(x,14,"purpur")}
  put(9,12,"purpur");put(10,12,"purpur")
  put(4,9,"chorusPlant");put(4,8,"chorusPlant");put(15,8,"chorusPlant");put(15,7,"chorusPlant");put(16,8,"chorusPlant")
  put(3,16,"endOre");put(6,18,"endOre");put(14,16,"endOre");put(17,20,"endOre")
  put(8,12,"endBrick");put(11,12,"endBrick");put(8,11,"endBrick");put(11,11,"endBrick")
  put(3,14,"air");put(3,13,"air");put(4,14,"air");put(4,13,"air")
  return world
}

function isSolid(type){ return type!=="air" && type!=="water" && type!=="torch" }
function placeable(type){ return {dirt:1,stone:1,wood:1,leaf:1,sand:1,glass:1,brick:1,torch:1,water:1,chest:1,craftingTable:1,coal:1,iron:1,gold:1,diamond:1,netherrack:1,soulSand:1,glowstone:1,netherBrick:1,quartzOre:1,blackstone:1,endStone:1,obsidian:1,purpur:1,chorusPlant:1,endBrick:1,endOre:1}[type]===1 }

export default {
  private:{
    world:createWorld(), visibleWorld:[], visibleAnimationMask:0, playerX:2, playerY:12, playerVy:0,
    selectedX:-1, selectedY:-1, selectedBlock:"dirt", mode:"MINE", status:"Tap blocks to mine",
    hudLine:"DAY | MINE | dirt x0 | 100%", loading:true, loadingProgress:0, loadingLabel:"Loading world...",
    loadingDisplay:"flex", menuDisplay:"none", settingsDisplay:"none", gameDisplay:"none", inventoryDisplay:"none", chestDisplay:"none", extraDisplay:"none", worldsDisplay:"none", victoryDisplay:"none", slotsConfirmDisplay:"none", craftDisplay:"none", workbenchDisplay:"none", mapDisplay:"none", toolsDisplay:"none", questsDisplay:"none", achievementsDisplay:"none", loadingTimer:null, gameTimer:null,
    dayTimer:null, dayPhase:0, dayStage:"DAY", dayNightEnabled:true, dayNightLabel:"DAY/NIGHT: ON", currentSlot:0, slotMenuDisplay:"none", zoomIndex:1,
